GITHUB_PERSONAL_ACCESS_TOKEN=
GOOGLE_GENERATIVE_AI_API_KEY=

# Datasource locations
DATABASE_PATH=data/database.db
LOGS_PATH=data/logs.db

# Bundled dev stack values (see ./service.sh and docs/usage.md).
# Uncomment these to use the local PostgreSQL and Prometheus containers.
# POSTGRES_URL=postgresql://sre_agent:sre_agent@localhost:55433/sre_agent
# PROMETHEUS_URL=http://localhost:19092
# ENABLE_POSTGRES=true
# ENABLE_PROMETHEUS=true

# External service defaults
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres
PROMETHEUS_URL=http://localhost:9090

# Enable integrations explicitly. Disabled sources are skipped during investigations.
ENABLE_POSTGRES=false
ENABLE_PROMETHEUS=false
ENABLE_DATABASE=true
ENABLE_LOGS=true
