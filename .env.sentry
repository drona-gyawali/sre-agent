# Local Sentry-compatible service included in the dev stack.
# Start it with: ./service.sh test
# Then copy these values into .env, or run: ./service.sh env --write
SENTRY_AUTH_TOKEN=sntryu_local_dev
SENTRY_ORG=acme
SENTRY_PROJECT=payments
SENTRY_HOST=http://localhost:19095
ENABLE_SENTRY=true

# For a real Sentry instance, replace the values above with:
# SENTRY_AUTH_TOKEN=sntryu_...
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_HOST=https://sentry.io
